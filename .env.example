# Read-only credential used only by GET /api/analytics/portfolio-report.
UPDASH_REPORTS_READ_TOKEN=replace-with-a-long-random-value

# Conta de serviço exclusiva de leitura de Google Ads (JSON no servidor).
GOOGLE_ADS_SERVICE_ACCOUNT_JSON=

# ID do cliente que recebe o piloto de revisão de pausas.
PRODUCT_CAMPAIGN_REVIEW_CLIENT_ID=
# IDs das marcas B2C habilitadas no Up Manager, separados por vírgula.
UP_MANAGER_CLIENT_IDS=
UP_MANAGER_PUBLIC_STOREFRONTS=

# Model override for the UP Agent. The scheduled job receives OPENAI_API_KEY from Secret Manager.
UP_MANAGER_OPENAI_MODEL=gpt-6.1-sol
# Opcional. Modelo usado nos diagnósticos agendados de rotina.
UP_MANAGER_OPENAI_ROUTINE_MODEL=
# Opcional. Hora de São Paulo a partir da qual a IA roda uma vez por dia.
UP_MANAGER_SCHEDULED_ANALYSIS_HOUR=
# Opcional. Em branco, os recados usam o texto do diagnóstico.
UP_MANAGER_COPY_MODEL=
UP_MANAGER_PAUSE_ENABLED=0

# Allows administrators to confirm only evidence-backed creative pauses.
UP_MANAGER_CREATIVE_PAUSE_ENABLED=0

# Enables review-confirmed Meta pause and budget changes from the Up Manager ROAS list.
UP_MANAGER_MEDIA_ACTIONS_ENABLED=0
UP_MANAGER_PAUSE_SCALE_ENABLED=0
UP_MANAGER_GRADE_PAUSE_ENABLED=0

# Each brand maps to one Meta catalog. Preview is the default. Live writes only the managed Product Set.
# UP_MANAGER_DPA_CATALOGS={"client-id":{"catalogId":"123456789","mode":"preview","manualRemoval":true}}
